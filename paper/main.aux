\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {SpatialMoE-SOD architecture.} Input $\mathbf  {X}\in \mathbb  {R}^{3 \times 384 \times 384}$ is processed by a PVTv2-B4 backbone to produce multi-scale features at $1/4$, $1/8$, $1/16$ resolution. Each scale is independently processed by a SpatialMoE layer: a depthwise convolutional router selects top-$K{=}2$ experts from 8 via noisy gating, and a per-token entropy map $\hat  {\mathcal  {H}}$ is computed. The decoder merges scales via global and windowed cross-attention, with entropy features injected via learned additive fusion at each scale. Two $1{\times }1$ conv heads produce saliency and boundary logits at full resolution.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{2}{\textbf {SpatialMoE-SOD architecture.} Input $\bX \in \reals ^{3 \times 384 \times 384}$ is processed by a PVTv2-B4 backbone to produce multi-scale features at $1/4$, $1/8$, $1/16$ resolution. Each scale is independently processed by a SpatialMoE layer: a depthwise convolutional router selects top-$K{=}2$ experts from 8 via noisy gating, and a per-token entropy map $\Hs $ is computed. The decoder merges scales via global and windowed cross-attention, with entropy features injected via learned additive fusion at each scale. Two $1{\times }1$ conv heads produce saliency and boundary logits at full resolution}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Routing mechanism for token $\mathbf  {x}_i$ at one pyramid scale.} A depthwise $3{\times }3$ convolution extracts local spatial context; the concatenation $\mathbf  {r}_i = [\mathbf  {x}_i | \text  {ctx}_i] \in \mathbb  {R}^{2C}$ is passed through a two-layer MLP to produce 8 routing logits. Noisy top-$K{=}2$ selection (Gaussian noise during training) picks two experts, branching into gate weights (top) and expert outputs (bottom); gate weights are softmax over selected logits only. The selected experts process the token independently; their outputs are summed with gate weights. Routing entropy $\hat  {\mathcal  {H}}_i \in [0,1]$ measures assignment uncertainty and is injected as a feature channel into the decoder via a learned $1{\times }1$ projection.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:router}{{2}{2}{\textbf {Routing mechanism for token $\bx _i$ at one pyramid scale.} A depthwise $3{\times }3$ convolution extracts local spatial context; the concatenation $\br _i = [\bx _i | \text {ctx}_i] \in \reals ^{2C}$ is passed through a two-layer MLP to produce 8 routing logits. Noisy top-$K{=}2$ selection (Gaussian noise during training) picks two experts, branching into gate weights (top) and expert outputs (bottom); gate weights are softmax over selected logits only. The selected experts process the token independently; their outputs are summed with gate weights. Routing entropy $\Hs _i \in [0,1]$ measures assignment uncertainty and is injected as a feature channel into the decoder via a learned $1{\times }1$ projection}{figure.caption.2}{}}
