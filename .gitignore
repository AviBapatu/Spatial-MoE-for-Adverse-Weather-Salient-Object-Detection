.env

# Ignore all individual prediction images from Hugging Face downloads, 
# but keep the important qualitative_grid.png and JSON/TXT metrics
evaluation_results/best/**/*.png
evaluation_results/force_expert_out/**/*.png

# Additional local output dirs
evaluation_results/
checkpoints/
preflight/
scratch_*.py

# Temp directories
.hf_sync_tmp/
test_outputs/

# Prediction images in results folders
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.webp

# LaTeX build artifacts (keep only the final PDF)
paper/*.aux
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
paper/*.synctex.gz

# local scratch
TODO*.md
HANDOFF.md
*.repo-backup

# ...but the qualitative grids ARE the evidence: keep them, they are one file per arm.
!results/**/qualitative/
!results/**/qualitative/*.png

